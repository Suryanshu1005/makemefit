# ==========================================
# MakeMeFit Application Configuration
# ==========================================

# Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://makemefit_user:makemefit_password@localhost:5432/makemefit_db

# Authentication Secrets
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_chars_long
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AI Vision Provider Configuration
AI_VISION_PROVIDER=mock # Options: 'mock' | 'gemini'
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Client URL (Web)
VITE_API_BASE_URL=http://localhost:4000/api/v1
